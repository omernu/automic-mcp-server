# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

# Base URL up to and including the API version.
# Form: http[s]://{host}:{port}/ae/api/{version}  (version must be v1)
AUTOMIC_BASE_URL=https://your-automic-host:8088/ae/api/v1

# AE client (tenant) number - used as {client_id} in every request path.
AUTOMIC_CLIENT_ID=100

# AE login used for Basic Auth.
AUTOMIC_USERNAME=your-username
AUTOMIC_PASSWORD=your-password

# Optional AE department. Leave unset if not applicable.
# AUTOMIC_DEPARTMENT=your-department

# Set to false ONLY for a known internal server with a self-signed cert
# (equivalent to `curl -k`). Disables TLS certificate verification - never
# do this for a server reachable over the public internet. Defaults to true.
# AUTOMIC_VERIFY_SSL=false

# --- Stage 4: execution guardrails (all off/empty by default) ---

# Master switch for the execute_object tool. Must be explicitly "true".
# AUTOMIC_ALLOW_EXECUTE=false

# Comma-separated object names/wildcard patterns allowed to be executed.
# Be as specific as you can - avoid a bare "*". Example:
# AUTOMIC_EXECUTE_ALLOWLIST=DAILY_BACKUP,TEST.JOBS.*

# How long (seconds) a preview_execution confirmation token stays valid.
# AUTOMIC_EXECUTE_CONFIRMATION_TTL_SECONDS=120

# Minimum time (seconds) between successful executions.
# AUTOMIC_EXECUTE_COOLDOWN_SECONDS=5

# Local, gitignored append-only log of every execution attempt.
# AUTOMIC_AUDIT_LOG_PATH=logs/executions.jsonl
